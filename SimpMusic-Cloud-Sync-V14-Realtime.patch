+    /**
+     * Keeps a user-scoped Postgres Changes subscription alive for the active SimpCloud session.
+     * The connected callback performs a catch-up sync after every socket reconnect, so events
+     * missed while offline are recovered without polling the database.
+     */
+    suspend fun observePlaybackChanges(onPlaybackInserted: () -> Unit) {
+        if (!isConfigured) return
+        client.auth.sessionStatus.collectLatest { sessionStatus ->
+            val session = (sessionStatus as? SessionStatus.Authenticated)?.session
+                ?: return@collectLatest
+            val userId = session.user?.id ?: return@collectLatest
+            val channel = client.channel("simpcloud-playback-$userId") {}
+            val inserts = channel.postgresChangeFlow<PostgresAction.Insert>(schema = "public") {
+                table = "cloud_playback_events"
+                filter = "user_id=eq.$userId"
+            }
+
+            coroutineScope {
+                val insertJob = launch {
+                    inserts.debounce(1_000).collect { onPlaybackInserted() }
+                }
+                val reconnectJob = launch {
+                    client.realtime.status
+                        .filter { it == Realtime.Status.CONNECTED }
+                        .collect {
+                            client.realtime.setAuth()
+                            onPlaybackInserted()
+                        }
+                }
+                try {
+                    client.realtime.setAuth(session.accessToken)
+                    channel.subscribe()
+                    awaitCancellation()
+                } finally {
+                    insertJob.cancel()
+                    reconnectJob.cancel()
+                    runCatching { client.realtime.removeChannel(channel) }
+                }
+            }
+        }
+    }
+
     suspend fun signOut() {
