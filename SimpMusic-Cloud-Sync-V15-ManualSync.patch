 import org.koin.mp.KoinPlatform.getKoin
+import java.util.concurrent.atomic.AtomicBoolean
 
+private val manualSyncInProgress = AtomicBoolean(false)
+private val manualSyncScope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+
 actual fun requestManualCloudSync() {
-    getKoin().get<CloudSyncManualSync>().scheduleManualSync()
+    val koin = getKoin()
+    val context: Context = koin.get()
+    if (!manualSyncInProgress.compareAndSet(false, true)) {
+        Toast.makeText(context, "SimpCloud sync is already running.", Toast.LENGTH_SHORT).show()
+        return
+    }
+
+    Toast.makeText(context, "SimpCloud: Syncing now…", Toast.LENGTH_SHORT).show()
+    manualSyncScope.launch {
+        try {
+            val result = koin.get<CloudSyncPlaybackSync>().syncNow()
+            Toast.makeText(
+                context,
+                "SimpCloud sync complete: ${result.uploaded} uploaded, ${result.downloaded} downloaded.",
+                Toast.LENGTH_LONG,
+            ).show()
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: Exception) {
+            val message = error.message?.take(150) ?: "Please try again."
+            Toast.makeText(context, "SimpCloud sync failed: $message", Toast.LENGTH_LONG).show()
+        } finally {
+            manualSyncInProgress.set(false)
+        }
+    }
 }
