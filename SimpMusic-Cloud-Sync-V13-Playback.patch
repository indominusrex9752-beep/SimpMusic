+@Composable
+private fun CloudSyncPage(
+    isConfigured: Boolean,
+    emailState: androidx.compose.runtime.MutableState<String?>,
+    onBack: () -> Unit,
+    onSignIn: suspend () -> Unit,
+    onSignOut: suspend () -> Unit,
+    onSync: suspend () -> CloudSyncResult,
+) {
+    val scope = rememberCoroutineScope()
+    var busy by androidx.compose.runtime.remember { mutableStateOf(false) }
+    var error by androidx.compose.runtime.remember { mutableStateOf<String?>(null) }
+    var syncStatus by androidx.compose.runtime.remember {
+        mutableStateOf("Listening history has not been synced yet.")
+    }
+
+    Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+        Column(
+            modifier = Modifier.fillMaxSize().padding(24.dp),
+            verticalArrangement = Arrangement.spacedBy(18.dp),
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                OutlinedButton(onClick = onBack) { Text("Back") }
+                Spacer(Modifier.width(12.dp))
+                Text("SimpCloud Sync", style = MaterialTheme.typography.headlineSmall)
+            }
+
+            Text(
+                "Use your Google account to connect SimpMusic to your private cloud space.",
+                style = MaterialTheme.typography.bodyLarge,
+            )
+
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                shape = RoundedCornerShape(20.dp),
+                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+            ) {
+                Column(
+                    modifier = Modifier.fillMaxWidth().padding(20.dp),
+                    verticalArrangement = Arrangement.spacedBy(10.dp),
+                ) {
+                    Text(
+                        if (emailState.value.isNullOrBlank()) "Not connected" else "Google account connected",
+                        style = MaterialTheme.typography.titleMedium,
+                    )
+                    if (!emailState.value.isNullOrBlank()) {
+                        Text(emailState.value.orEmpty(), style = MaterialTheme.typography.bodyMedium)
+                    } else {
+                        Text(
+                            "Sign in to establish your SimpCloud identity.",
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+
+                    if (!isConfigured) {
+                        Text(
+                            "Cloud Sync is not configured. Check the Supabase build configuration.",
+                            color = MaterialTheme.colorScheme.error,
+                        )
+                    } else if (emailState.value.isNullOrBlank()) {
+                        Button(
+                            onClick = {
+                                error = null
+                                scope.launch {
+                                    busy = true
+                                    try {
+                                        onSignIn()
+                                    } catch (t: Throwable) {
+                                        error = t.message ?: "Google sign-in could not be started."
+                                    } finally {
+                                        busy = false
+                                    }
+                                }
+                            },
+                            enabled = !busy,
+                            modifier = Modifier.fillMaxWidth(),
+                        ) {
+                            if (busy) {
+                                CircularProgressIndicator()
+                            } else {
+                                Text("Continue with Google")
+                            }
+                        }
+                    } else {
+                        Button(
+                            onClick = {
+                                error = null
+                                scope.launch {
+                                    busy = true
+                                    try {
