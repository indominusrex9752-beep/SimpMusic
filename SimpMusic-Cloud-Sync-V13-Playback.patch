@@ -0,0 +1,260 @@
+package com.maxrave.simpmusic.cloudsync
+
+import android.content.Context
+import android.os.Build
+import com.maxrave.data.db.SyncDao
+import com.maxrave.domain.data.entities.analytics.PlaybackEventEntity
+import com.maxrave.simpmusic.BuildConfig
+import com.maxrave.simpmusic.BuildKonfig
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.toInstant
+import kotlinx.datetime.toLocalDateTime
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.time.Instant as JavaInstant
+import java.util.UUID
+import kotlin.time.Instant
+
+data class CloudSyncResult(val uploaded: Int, val downloaded: Int)
+
+class CloudSyncPlaybackSync(
+    context: Context,
+    private val auth: CloudSyncAuth,
+    private val dao: SyncDao,
+) {
+    private val preferences =
+        context.applicationContext.getSharedPreferences("simpcloud_device", Context.MODE_PRIVATE)
+
+    suspend fun syncNow(): CloudSyncResult = withContext(Dispatchers.IO) {
+        val credentials = auth.cloudCredentials()
+            ?: throw IllegalStateException("Connect your Google account before syncing.")
+        val deviceKey = deviceKey()
+        val deviceCreatedAt = registerDevice(credentials.userId, credentials.accessToken, deviceKey)
+        val from = Instant.fromEpochMilliseconds(
+            JavaInstant.parse(deviceCreatedAt).toEpochMilli(),
+        ).toLocalDateTime(TimeZone.UTC)
+
+        // Assign stable IDs only to previously untagged local events from this device's cloud-link date.
+        dao.eventsWithoutSyncId(from).forEach { event ->
+            dao.setEventSyncId(event.eventId, UUID.randomUUID().toString())
+        }
+
+        val localIds = dao.ownEventSyncIdsSince(from).distinct()
+        var uploaded = 0
+        localIds.chunked(BATCH_SIZE).forEach { batch ->
+            val rows = JSONArray()
+            dao.eventsBySyncId(batch).forEach { event ->
+                val syncId = event.syncId ?: return@forEach
+                val artists = JSONArray()
+                dao.eventArtists(event.eventId).distinct().forEach(artists::put)
+                rows.put(
+                    JSONObject()
+                        .put("user_id", credentials.userId)
+                        .put("sync_id", syncId)
+                        .put("device_key", deviceKey)
+                        .put("played_at", event.timestamp.toInstant(TimeZone.UTC).toString())
+                        .put("video_id", event.videoId)
+                        .put("album_browse_id", event.albumBrowseId ?: JSONObject.NULL)
+                        .put("duration_seconds", event.durationSecond)
+                        .put("listened_seconds", event.listenedSecond)
+                        .put("artist_ids", artists),
+                )
+            }
+            if (rows.length() > 0) {
+                request(
+                    "POST",
+                    "cloud_playback_events?on_conflict=user_id,sync_id",
+                    credentials.accessToken,
+                    rows.toString(),
+                    "resolution=ignore-duplicates,return=minimal",
+                )
+                uploaded += rows.length()
+            }
+        }
+
+        val cursor = readOrCreateSyncState(credentials.userId, credentials.accessToken, deviceKey)
+        var newestCursor = cursor
+        var offset = 0
+        var downloaded = 0
+        while (true) {
+            val query =
+                "cloud_playback_events?select=sync_id,device_key,played_at,video_id,album_browse_id,duration_seconds,listened_seconds,artist_ids,created_at" +
+                    "&user_id=eq.${encode(credentials.userId)}" +
+                    (cursor?.let { "&created_at=gte.${encode(it)}" } ?: "") +
+                    "&order=created_at.asc,id.asc&limit=$BATCH_SIZE&offset=$offset"
+            val page = JSONArray(request("GET", query, credentials.accessToken))
+            for (index in 0 until page.length()) {
+                val row = page.getJSONObject(index)
+                newestCursor = newerCursor(newestCursor, row.getString("created_at"))
+                if (row.getString("device_key") == deviceKey) continue
+
+                val playedAt = JavaInstant.parse(row.getString("played_at")).toEpochMilli()
+                val timestamp = Instant.fromEpochMilliseconds(playedAt).toLocalDateTime(TimeZone.UTC)
+                val artistArray = row.optJSONArray("artist_ids") ?: JSONArray()
+                val artists = buildList {
+                    for (artistIndex in 0 until artistArray.length()) {
+                        artistArray.optString(artistIndex).takeIf { it.isNotBlank() }?.let(::add)
+                    }
+                }
+                dao.insertEventWithArtists(
+                    PlaybackEventEntity(
+                        timestamp = timestamp,
+                        videoId = row.getString("video_id"),
+                        albumBrowseId = row.optString("album_browse_id").takeIf { it.isNotBlank() },
+                        durationSecond = row.optLong("duration_seconds"),
+                        listenedSecond = row.optLong("listened_seconds"),
+                        syncId = row.getString("sync_id"),
+                        deviceId = row.getString("device_key"),
+                    ),
+                    artists,
+                )
+                downloaded++
+            }
+            if (page.length() < BATCH_SIZE) break
+            offset += page.length()
+        }
+
+        val now = JavaInstant.now().toString()
+        val state = JSONObject()
+            .put("last_upload_at", now)
+            .put("last_download_at", now)
+            .put("server_cursor", newestCursor ?: JSONObject.NULL)
+            .put("updated_at", now)
+        request(
+            "PATCH",
+            "cloud_sync_state?user_id=eq.${encode(credentials.userId)}&device_key=eq.${encode(deviceKey)}",
+            credentials.accessToken,
+            state.toString(),
+            "return=minimal",
+        )
+        CloudSyncResult(uploaded, downloaded)
+    }
+
+    private fun registerDevice(userId: String, token: String, deviceKey: String): String {
+        val filter =
+            "cloud_devices?select=created_at,revoked_at&user_id=eq.${encode(userId)}&device_key=eq.${encode(deviceKey)}&limit=1"
+        val existing = JSONArray(request("GET", filter, token))
+        if (existing.length() > 0) {
+            val row = existing.getJSONObject(0)
+            if (!row.isNull("revoked_at")) {
+                throw IllegalStateException("This device has been revoked from SimpCloud.")
+            }
+            request(
+                "PATCH",
+                "cloud_devices?user_id=eq.${encode(userId)}&device_key=eq.${encode(deviceKey)}",
+                token,
+                JSONObject().put("last_seen_at", JavaInstant.now().toString()).toString(),
+                "return=minimal",
+            )
+            return row.getString("created_at")
+        }
+
+        val body = JSONArray().put(
+            JSONObject()
+                .put("user_id", userId)
+                .put("device_key", deviceKey)
+                .put("device_name", Build.MODEL.orEmpty().ifBlank { "Android device" })
+                .put("platform", "android")
+                .put("app_version", BuildConfig.VERSION_NAME)
+                .put("last_seen_at", JavaInstant.now().toString()),
+        )
+        val inserted = JSONArray(
+            request(
+                "POST",
+                "cloud_devices?on_conflict=user_id,device_key",
+                token,
+                body.toString(),
+                "resolution=ignore-duplicates,return=representation",
+            ),
+        )
+        if (inserted.length() > 0) return inserted.getJSONObject(0).getString("created_at")
+        val raced = JSONArray(request("GET", filter, token))
+        if (raced.length() == 0 || !raced.getJSONObject(0).isNull("revoked_at")) {
+            throw IOException("Could not register this SimpCloud device.")
+        }
+        return raced.getJSONObject(0).getString("created_at")
+    }
+
+    private fun readOrCreateSyncState(userId: String, token: String, deviceKey: String): String? {
+        val filter =
+            "cloud_sync_state?select=server_cursor&user_id=eq.${encode(userId)}&device_key=eq.${encode(deviceKey)}&limit=1"
+        val rows = JSONArray(request("GET", filter, token))
+        if (rows.length() > 0) {
+            val row = rows.getJSONObject(0)
+    +        return if (row.isNull("server_cursor")) null else row.optString("server_cursor").takeIf { it.isNotBlank() }
+        }
+        val body = JSONArray().put(JSONObject().put("user_id", userId).put("device_key", deviceKey))
+        request(
+            "POST",
+            "cloud_sync_state?on_conflict=user_id,device_key",
+            token,
+            body.toString(),
+            "resolution=ignore-duplicates,return=minimal",
+        )
+        val retry = JSONArray(request("GET", filter, token))
+        if (retry.length() == 0) throw IOException("Could not initialize the SimpCloud sync cursor.")
+        val row = retry.getJSONObject(0)
        return if (row.isNull("server_cursor")) null else row.optString("server_cursor").takeIf { it.isNotBlank() }
+    }
+
+    private fun deviceKey(): String =
+        preferences.getString(KEY_DEVICE, null) ?: UUID.randomUUID().toString().also {
+            preferences.edit().putString(KEY_DEVICE, it).apply()
+        }
+
+    private fun request(
+        method: String,
+        path: String,
+        token: String,
+        body: String? = null,
+        prefer: String? = null,
+    ): String {
+        val connection = URL("${BuildKonfig.supabaseUrl.trimEnd('/')}/rest/v1/$path")
+            .openConnection() as HttpURLConnection
+        try {
+            connection.requestMethod = method
+            connection.connectTimeout = TIMEOUT_MS
+            connection.readTimeout = TIMEOUT_MS
+            connection.setRequestProperty("apikey", BuildKonfig.supabasePublishableKey)
+            connection.setRequestProperty("Authorization", "Bearer $token")
+            connection.setRequestProperty("Accept", "application/json")
+            connection.setRequestProperty("Content-Type", "application/json")
+            prefer?.let { connection.setRequestProperty("Prefer", it) }
+            if (body != null) {
+                connection.doOutput = true
+                connection.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            }
+            val status = connection.responseCode
+            val stream = if (status in 200..299) connection.inputStream else connection.errorStream
+            val response = stream?.bufferedReader(Charsets.UTF_8)?.use { it.readText() }.orEmpty()
+            if (status !in 200..299) {
+                val message = runCatching { JSONObject(response).optString("message") }.getOrNull()
+                throw IOException(
+                    "Cloud sync request failed ($status): " +
+                        (message?.takeIf { it.isNotBlank() } ?: response.take(180)),
+                )
+            }
+            return response
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun encode(value: String): String = URLEncoder.encode(value, Charsets.UTF_8.name())
+
+    private fun newerCursor(current: String?, candidate: String): String =
+        if (current == null || JavaInstant.parse(candidate).isAfter(JavaInstant.parse(current))) candidate
+        else current
+
+    private companion object {
+        const val KEY_DEVICE = "device_key"
+        const val BATCH_SIZE = 200
+        const val TIMEOUT_MS = 20_000
+    }
+}
