+    private val cloudSyncPlaybackSync: CloudSyncPlaybackSync by inject()
+    private val emailState = mutableStateOf<String?>(null)
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        handleAuthIntent(intent)
+        emailState.value = cloudSyncAuth.authenticatedEmail()
+        setContent {
+            MaterialTheme {
+                CloudSyncPage(
+                    isConfigured = cloudSyncAuth.isConfigured,
+                    emailState = emailState,
+                    onBack = { finish() },
+                    onSignIn = {
+                        cloudSyncAuth.signInWithGoogle()
+                    },
+                    onSignOut = {
+                        cloudSyncAuth.signOut()
+                        emailState.value = cloudSyncAuth.authenticatedEmail()
+                    },
+                    onSync = { cloudSyncPlaybackSync.syncNow() },
+                )
+            }
+        }
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        setIntent(intent)
+        handleAuthIntent(intent)
+        emailState.value = cloudSyncAuth.authenticatedEmail()
+    }
+
+    override fun onResume() {
+        super.onResume()
+        emailState.value = cloudSyncAuth.authenticatedEmail()
+    }
+
+    private fun handleAuthIntent(intent: Intent?) {
+        if (intent?.data?.let {
+                it.scheme == "simpmusic" && it.host == "auth-callback"
+            } == true
+        ) {
+            cloudSyncAuth.handleCallback(intent)
+        }
+    }
+}
