@@ -0,0 +1,68 @@
+package com.maxrave.simpmusic.cloudsync
+
+import android.content.Intent
+import com.maxrave.simpmusic.BuildKonfig
+import io.github.jan.supabase.auth.Auth
+import io.github.jan.supabase.auth.FlowType
+import io.github.jan.supabase.auth.auth
+import io.github.jan.supabase.auth.handleDeeplinks
+import io.github.jan.supabase.auth.providers.Google
+import io.github.jan.supabase.createSupabaseClient
+
+/**
+ * Android-only Supabase authentication boundary.
+ *
+ * The publishable key is intentionally the only key shipped in the client.
+ * No YouTube cookies, browser cookies, or Google passwords are sent to Supabase.
+ */
+class CloudSyncAuth {
+    val isConfigured: Boolean
+        get() = BuildKonfig.supabaseUrl.isNotBlank() &&
+            BuildKonfig.supabasePublishableKey.isNotBlank()
+
+    private val client by lazy {
+        check(isConfigured) {
+            "Cloud Sync is not configured. Check SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY."
+        }
+        createSupabaseClient(
+            supabaseUrl = BuildKonfig.supabaseUrl,
+            supabaseKey = BuildKonfig.supabasePublishableKey,
+        ) {
+            install(Auth) {
+                scheme = CALLBACK_SCHEME
+                host = CALLBACK_HOST
+                flowType = FlowType.PKCE
+            }
+        }
+    }
+
+    /**
+     * Handles only our OAuth callback. Other simpmusic:// links must continue
+     * through SimpMusic's existing GenericIntent routing.
+     */
+    fun handleCallback(intent: Intent) {
+        val uri = intent.data ?: return
+        if (uri.scheme == CALLBACK_SCHEME && uri.host == CALLBACK_HOST && isConfigured) {
+            client.handleDeeplinks(intent)
+        }
+    }
+
+    suspend fun signInWithGoogle() {
+        check(isConfigured) {
+            "Cloud Sync is not configured. Check the Supabase build secrets."
+        }
+        client.auth.signInWith(Google)
+    }
+
+    fun authenticatedEmail(): String? =
+        if (isConfigured) client.auth.currentUserOrNull()?.email else null
+
+    suspend fun signOut() {
+        if (isConfigured) client.auth.signOut()
+    }
+
+    private companion object {
+        const val CALLBACK_SCHEME = "simpmusic"
+        const val CALLBACK_HOST = "auth-callback"
+    }
+}
